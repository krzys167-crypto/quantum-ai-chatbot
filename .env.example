# Client (Vite) — baked in at build time on Render
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server — never expose these to the browser
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
# Public origin (Cloudflare custom domain). No trailing slash.
APP_URL=https://quantumy.work

# Irreversible actions (Gmail send / reply / forward, calendar events and edits that reach guests, comments on shared files): unset or "server" = the user must press Confirm on a card shown in the
# app (needs supabase/approval-requests.sql). "legacy" = EMERGENCY ONLY: the model's own flag releases the action (F09 open).
# APPROVAL_MODE=server

# Protects cron + risc-register. Render cron sends Authorization: Bearer $CRON_SECRET
# Generate with: openssl rand -hex 32
CRON_SECRET=

GOOGLE_RISC_SERVICE_ACCOUNT_EMAIL=xxxxx@your-project.iam.gserviceaccount.com
GOOGLE_RISC_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ElevenLabs (STT + TTS) — English & Hausa
ELEVENLABS_API_KEY=sk_...

# Optional web search
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
# BRAVE_SEARCH_API_KEY=...

# Connector token encryption at rest (optional but recommended). 32 random bytes, base64:
#   openssl rand -base64 32
# Losing or changing this key makes already-encrypted tokens unreadable (users must reconnect).
# CONNECTOR_TOKEN_KEY=
# Rollback step after sealing: stop writing sealed values (sealed rows stay readable). See docs/connector-security.md.
# CONNECTOR_TOKEN_SEAL=off
# Recommended once sealing is on: refuse to connect / store tokens without a valid key (set in every environment).
# CONNECTOR_TOKEN_REQUIRE_KEY=1
