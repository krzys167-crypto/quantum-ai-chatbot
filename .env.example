# Client (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Server (Vercel) — never expose these to the browser
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
APP_URL=https://quantumy-ai.vercel.app

# Any random string — protects the daily overdue-notes cron endpoint AND the
# one-off api/admin/risc-register.js action (both check the same secret).
# Vercel sends it back as "Authorization: Bearer $CRON_SECRET" automatically
# when it triggers api/cron/notes-reminders.js. Generate with: openssl rand -hex 32
CRON_SECRET=

# Cross-Account Protection (RISC) — from the service account JSON key you
# download in Google Cloud Console (Credentials > Service Accounts). Used by
# api/security-events.js to receive Google security event notifications
# (account compromised/disabled/sessions revoked) and by
# api/admin/risc-register.js to register that endpoint with Google.
GOOGLE_RISC_SERVICE_ACCOUNT_EMAIL=xxxxx@your-project.iam.gserviceaccount.com
GOOGLE_RISC_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional: comma-separated list of OAuth client IDs the incoming events may be
# addressed to. Defaults to GOOGLE_CLIENT_ID if unset — only needed if your
# Google Sign-In client ID differs from the connector OAuth client ID above.
# RISC_AUDIENCE_CLIENT_IDS=

# ElevenLabs (STT + TTS) — English & Hausa
ELEVENLABS_API_KEY=sk_...
# Voices (optional overrides)
# ELEVENLABS_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_VOICE_MALE=rPlZjuLXpONhaMouRFww
# ELEVENLABS_VOICE_HAUSA_MALE=rPlZjuLXpONhaMouRFww
# ELEVENLABS_VOICE_HAUSA_FEMALE=...
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Web search (optional — any one is enough; falls back to free DuckDuckGo)
# Prefer Tavily for AI-optimized results: https://tavily.com
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...          # https://serper.dev
# BRAVE_SEARCH_API_KEY=...    # https://brave.com/search/api/

# Irreversible Gmail actions (send / reply / forward): unset or "server" = the user must press Confirm on a card shown in the
# app (needs supabase/approval-requests.sql). "legacy" = EMERGENCY ONLY: the model's own flag releases the action (F09 open).
# APPROVAL_MODE=server
